# Telemetry API database connection (Docker Compose)
DATABASE_URL=postgresql+psycopg://telemetry_user:change_me@db:5432/telemetry_db

# Telemetry PostgreSQL database
POSTGRES_DB=telemetry_db
POSTGRES_USER=telemetry_user
POSTGRES_PASSWORD=change_me

# Airflow PostgreSQL database
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change_me

# Airflow web UI (local development only)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com